  "scripts": {
    "configure": "node scripts/configure.mjs",
    "assets": "capacitor-assets generate --iconBackgroundColor \"#ffffff\" --splashBackgroundColor \"#111111\"",
    "sync": "npm run configure && cap sync",
    "android": "npm run sync && cap run android",
    "ios": "npm run sync && cap run ios"
